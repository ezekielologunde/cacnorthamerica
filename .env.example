NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://cacna.org
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public (pk_...) key, used only when embedded Checkout is switched on below.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Checkout opens Stripe's own hosted page by default. Set to "true" (with the
# key above) to show it embedded inside the site instead.
NEXT_PUBLIC_STRIPE_EMBEDDED=
# Seals free (all-children) registration confirmation links. Optional: when
# unset, a key is derived from STRIPE_SECRET_KEY. Changing it (or setting it
# for the first time) invalidates free confirmation links issued before.
REGISTRATION_SIGNING_SECRET=
RESEND_API_KEY=
BEHOLD_FEED_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_ADSENSE_ID=
YOUTUBE_API_KEY=
SHEETS_WEBHOOK=
SHEETS_WEBHOOK_SECRET=

# Cloudflare Turnstile (spam protection on contact, newsletter and registration forms).
# Set both together: the site key shows the widget, the secret turns on server checks.
# Leave both empty to run without it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Social cross-post (/admin/social). Server-only: never NEXT_PUBLIC_. Leave a
# platform's variables empty and it is logged as "not connected". Real posting
# also needs the switches in /admin/social/settings (all off by default).
#
# Facebook Page: the numeric Page id, and a long-lived Page access token from
# someone with the CREATE_CONTENT task (pages_manage_posts,
# pages_read_engagement, pages_show_list). A Page token made from a
# long-lived User token has no expiry date; if Meta invalidates it the post
# log shows "Reconnect needed" and a new token goes here.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Instagram (professional account linked to that Page): the numeric IG user
# id. Publishing takes a Page access token (instagram_basic,
# instagram_content_publish); leave INSTAGRAM_ACCESS_TOKEN empty to reuse the
# Facebook Page token above.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# TikTok (Content Posting API, Direct Post, video.publish). Access tokens last
# 2 hours and refresh tokens 180 days, and each refresh replaces the refresh
# token, so TIKTOK_REFRESH_TOKEN only seeds the chain: the site keeps the
# current pair encrypted in the database. Pasting a different refresh token
# here restarts the chain (that is how to reconnect).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
# The URL prefix verified in the TikTok developer portal for PULL_FROM_URL;
# next.config.ts serves /social-video/<id>.<ext> from Cloudinary.
# Example: https://cacna.org/social-video/
TIKTOK_PULL_URL_PREFIX=
# Until TikTok audits the app every post is private. Set to true only after
# the audit has passed.
TIKTOK_APP_AUDITED=false
# 32 random bytes, base64 (e.g. `openssl rand -base64 32`). Encrypts the
# stored TikTok tokens; changing it means reconnecting TikTok.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Scheduled content refresh (vercel.json cron -> /api/cron/refresh-content).
# Random string, at least 16 characters; Vercel Cron sends it as a Bearer token.
# Unset = the endpoint refuses every request. See docs/cron-refresh-content.md.
CRON_SECRET=
